{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "jsx": "preserve",
    "types": ["vite/client"],
    "paths": {
      "@headless-kit/vue": ["./packages/headless/src/index.js"]
    }
  },
  "include": ["packages/*/src/**/*", "apps/docs/src/**/*", "packages/*/test/**/*"],
  "exclude": ["**/dist/**", "**/node_modules/**"]
}
