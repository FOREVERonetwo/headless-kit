{
  "name": "@headless-kit/vue",
  "version": "0.4.0",
  "description": "Unstyled, accessible Vue 3 primitives for building design systems. No runtime CSS, no DOM opinions, full ARIA.",
  "keywords": [
    "vue",
    "vue3",
    "headless",
    "headlessui",
    "accessible",
    "a11y",
    "aria",
    "design-system",
    "unstyled",
    "primitives",
    "dialog",
    "popover",
    "combobox"
  ],
  "license": "MIT",
  "author": "headless-kit contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/headless-kit/headless-kit.git",
    "directory": "packages/headless"
  },
  "bugs": {
    "url": "https://github.com/headless-kit/headless-kit/issues"
  },
  "homepage": "https://headless-kit.dev",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^2.1.8",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-dts": "^5.1.2",
    "vue": "^3.5.13"
  },
  "publishConfig": {
    "access": "public"
  }
}
